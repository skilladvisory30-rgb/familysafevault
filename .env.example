# FamilyKYCManager Environment Configuration Template
# Copy this file to .env or configure in Vercel Environment Variables

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
ENV_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Key (found in Supabase Dashboard -> Project Settings -> API)
ENV_SUPABASE_ANON_KEY="your-anon-key-here"
